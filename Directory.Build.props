<Project>
  <!-- Makes the code style rules in .editorconfig part of every build, so an error there fails it. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Release Please raises this on each release; until the first one, 0.0.0 shows in game as RC. -->
  <PropertyGroup>
    <Version>1.6.0</Version> <!-- x-release-please-version -->
  </PropertyGroup>
</Project>
