layout_mode = 2
text = "Instance game/Procedural/close_button.tscn beside a window's frame, inside an HBox with separation 1. It is a ClickArea with LightsUp on, so it brightens itself on hover and hold; any ClickArea can do the same by turning LightsUp on. Point its LitContent at one child to light only that child, as the + and - cells of the stat rows light only their sign. Keep that child beside the panel, not inside it: a panel's shader drops brightening from what it holds."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

