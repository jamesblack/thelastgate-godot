[node name="Text" type="Label" parent="Page/Picker/Notes" unique_id=1107766403]
layout_mode = 2
text = "Instance game/Procedural/picker.tscn where the player picks one of a few named choices, such as a weapon. It is a field-like box, Profile GBG and Fill Blue, showing the choice and a v. Give it a width, call SetChoices with the names and Select to show one without a signal, and connect ItemChosen. A left click opens its own menu straight under it, as wide as the box; Escape or a click outside closes it. Set Tooltip for a styled tooltip, and Disabled to fade it. PreviewChoice and PreviewOpen are for this page."
custom_minimum_size = Vector2(380, 0)
autowrap_mode = 3
script = ExtResource("3_label")
Colour = 1

