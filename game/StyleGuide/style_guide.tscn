[node name="Text" type="Label" parent="Page/ScrollBar/Notes" unique_id=1649696924]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
text = "Add a VScrollBar with ProceduralScrollBar.cs inside a column panel (min width 9, Padding 1, Fill Red) and set its horizontal size flag to Fill. The script brings everything else: the panel shader draws the grabber in border-grained green with no rings, so it stays green wherever it scrolls, and it lights up 1.6x hovered and 2.0x dragged. Its material and styles are made in code and never saved. Set max_value to the item count and page to the rows shown. A bar that scrolls one row at a time with no page (the skill list) sets MinimumGrabberLength instead, so its grabber keeps that many pixels."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

