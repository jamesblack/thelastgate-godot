[node name="Intro" type="Label" parent="Page" unique_id=889541096]
custom_minimum_size = Vector2(980, 0)
layout_mode = 2
text = "Every themed window is built from these parts. Select an example and change it in the Inspector to try a setting. Panels and lines are game/Procedural/ProceduralPanel.cs and ProceduralLine.cs; the shared buttons are game/Procedural/text_button.tscn and close_button.tscn; item cells are game/Hud/item_cell.tscn; text is game/Hud/HudLabel.cs. The finished windows live in game/Hud/ (Shop, Depot, Smith, Waypoints, TextWindow, SkillTree)."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

