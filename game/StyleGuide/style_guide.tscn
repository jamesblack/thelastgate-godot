[node name="Text" type="Label" parent="Page/Fading/Notes" unique_id=1543231953]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
text = "FadesAs names the window background option that fades this panel (Shop, Depot, Smith, SkillTree, Waypoints, Text); None stays solid. Fading changes the panel's own alpha, never its children's, so put it on the body and leave frames, footers and buttons at None. SolidRings keeps the rings at full strength while the fill fades, as on the waypoint rows. These examples are faded by hand to 40%."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

