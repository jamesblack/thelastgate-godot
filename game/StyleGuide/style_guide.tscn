layout_mode = 2
text = "Window (HBox, separation 1) > Frame (GBGGBG, Fill None, mouse_filter Stop so clicks never reach the world) > Layout (VBox, separation 0) > Body (Fill Red, FadesAs the window) and Footer (Fill Blue, GBG, Edges Top) holding text buttons; then the close button. Every node that only lays out sets mouse_filter Ignore. Save the scene visible and hide it in _Ready outside the editor."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

