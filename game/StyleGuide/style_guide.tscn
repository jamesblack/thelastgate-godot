[node name="Text" type="Label" parent="Page/Edges/Notes" unique_id=133102462]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
text = "Which sides draw rings (Top 1, Right 2, Bottom 4, Left 8; add them up). Leave a side out where two boxes touch so they share one border: a footer under a body uses Edges Top only, so the frame's rings close it on the other three sides. When the boxes overlap by the rings' width and only part of a side touches, give each JoinedWith the others' rects in its own pixels: the rings then follow the outline of them all and turn at the inside corners, as on the equipment cross, the quick options, the minimap zoom buttons and the skill list footers. Edges still decides where children sit, so leave out the side that joins."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

