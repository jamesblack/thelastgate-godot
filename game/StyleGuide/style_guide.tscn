[node name="Text" type="Label" parent="Page/Tabs/Notes" unique_id=1680796036]
layout_mode = 2
text = "Give a Container game/Procedural/ProceduralTabs.cs, with one child: Page, a ProceduralPanel with Profile GBG, Fill Red and Padding 4 holding one child per page. Set Titles, one per page. It adds a tab per title and lays them over the top ring of the page, layering them by tree order, not z_index: no tab has a bottom ring, so the page's top ring runs unbroken over the closed tabs, which are blue with Grey text and light up when hovered; the open tab is red with Yellow text and drawn in front, so it opens into the page, its sides turning into the page's ring at its bottom corners. Select shows a page without a signal; TabChosen fires when a closed tab is clicked."
custom_minimum_size = Vector2(380, 0)
autowrap_mode = 3
script = ExtResource("3_label")
Colour = 1

