[node name="Text" type="Label" parent="Page/DataTable/Notes" unique_id=1336119661]
layout_mode = 2
text = "Give a VBoxContainer game/Procedural/DataTable.cs and call SetColumns with the header of each column, its share of the width and its group, then ShowRows. Groups get a White caption with a gold rule across their columns; the headers are White with a gold rule under them; each row is a settings row, ruled apart and filled while hovered. The first column is the name, the rest are right-aligned, and the tone of a cell colours it: Positive Green, Negative Red, Zero Dim, Dim Grey, Normal Yellow. Preview fills it for this page."
custom_minimum_size = Vector2(380, 0)
autowrap_mode = 3
script = ExtResource("3_label")
Colour = 1

