[node name="Text" type="Label" parent="Page/Shape/Notes" unique_id=966761410]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
text = "Box is the usual rect. Circle rounds it to the largest circle that fits. Close draws the close cross inside the rings (the close button uses it with Profile G). Diamond draws the isometric 2:1 diamond of the HUD art; give it a width twice its height plus one row (44 x 21 is the tile under the list buttons), and each ring is a three-pixel run per row like the art's slanted lines. Hole cuts the same diamond out of any panel, given as x, y, width and height in the panel's own pixels; the HUD background is a Fill Blue panel with a Hole for the world's window."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

