[node name="Text" type="Label" parent="Page/Menu/Notes" unique_id=984398179]
layout_mode = 2
text = "Instance game/Procedural/procedural_menu.tscn once per menu and fill it from code each time it opens: Clear, then AddHeading, AddSeparator, AddItem (id, enabled, tooltip), AddCheckItem, AddSubmenu (another menu instance) and AddRow (any Control, such as a colour picker). Popup(position) shows it inside the screen; it closes on Escape, on a click outside (which it swallows), and after an item is chosen; KeepOpenOnCheck keeps it open for check items. Connect ItemChosen. A GBG red box; the hovered row is steel blue and lit 1.3x, disabled rows are Dim, and submenus open beside their row. Preview fills an instance with sample rows for this page."
custom_minimum_size = Vector2(380, 0)
autowrap_mode = 3
script = ExtResource("3_label")
Colour = 1

