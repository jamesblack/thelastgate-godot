[node name="Text" type="Label" parent="Page/TreeRow/Notes" unique_id=1817564832]
layout_mode = 2
text = "game/Map/category_row.tscn is one row of a tree list: indent 10 per level, the chevron (> closed, v open), a 9 x 9 swatch and the name. Notes keep their Pin:, Text: or Path: prefix and an empty swatch when they use their category's colour. Current is steel blue; Selected is steel blue with a G ring; hovered lights 2.2x; Dimmed (a hidden category) has Dim text and a dark swatch. The list (category_list.tscn) pools the rows beside the scroll bar; Preview fills it with sample notes, so drag them about here."
custom_minimum_size = Vector2(380, 0)
autowrap_mode = 3
script = ExtResource("3_label")
