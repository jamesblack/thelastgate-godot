[node name="Text" type="Label" parent="Page/Profile/Notes" unique_id=835592039]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
text = "Add a Container with ProceduralPanel.cs. Profile lists its rings from the outside in, one letter per pixel: G gold, B blue gap, R red, W white. Its children are laid out inside the rings. Windows use GBGGBG for the frame and GBG for boxes inside it; G alone makes a single line."
script = ExtResource("3_label")
Colour = 1
autowrap_mode = 3

